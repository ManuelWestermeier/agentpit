{
  "manifest_version": 3,
  "name": "agentpit media bridge",
  "description": "Sound, microphone, camera and dropdowns for remote viewers of this agentpit browser identity.",
  "version": "1.0.0",
  "key": "",
  "minimum_chrome_version": "116",
  "background": {
    "service_worker": "sw.js"
  },
  "permissions": [
    "tabCapture",
    "offscreen",
    "tabs",
    "alarms"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "main.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_origin_as_fallback": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "isolated.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_origin_as_fallback": true
    }
  ]
}
