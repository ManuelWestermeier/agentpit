# Kopieren nach .env und anpassen. Alle Werte sind optional.

# Server (nur loopback; anderes erfordert ALLOW_NON_LOOPBACK=true – nicht empfohlen)
PORT=4317
# PREVIEW_PORT=4318          # Datei-Vorschau auf eigenem Origin (Standard: PORT+1)
HOST=127.0.0.1
OPEN_BROWSER=true

# Ordner (relativ zum Cockpit-Ordner oder absolut)
PROJECTS_DIR=projects
DATA_DIR=data

# Sessions
DEFAULT_MODEL=                # leer = Standard von Claude Code; z. B. opus, sonnet, fable
DEFAULT_PERMISSION_MODE=acceptEdits   # default | acceptEdits | auto | plan | dontAsk
DEFAULT_EFFORT=               # leer | low | medium | high | xhigh | max
IDLE_TIMEOUT_MIN=20           # Prozess nach N min Leerlauf beenden (Session bleibt fortsetzbar), 0 = nie
MAX_RUNNERS=6                 # gleichzeitig laufende Claude-Code-Prozesse (je ca. 300–500 MB RAM)
ALLOW_BYPASS_PERMISSIONS=false  # true schaltet den Modus "Ohne Nachfrage" frei
PROMPT_SUGGESTIONS=false      # Vorschlag für den nächsten Prompt (kostet etwas Nutzung)
HISTORY_LIMIT=4000            # max. geladene Ereignisse pro Session-Ansicht

# Verbrauch
USAGE_POLL_SEC=300            # Plan-Limits abfragen, solange ein Browser verbunden ist

# Browser-Steuerung (Playwright MCP)
BROWSER_MCP=true
BROWSER_CHANNEL=              # leer = automatisch (chrome, sonst msedge)

# Eigene Claude-Code-Installation statt der aus dem Agent SDK (normalerweise nicht nötig)
# CLAUDE_BIN=C:\Users\<du>\.local\bin\claude.exe

# Authentifizierung ohne Login (hat Vorrang vor dem Login im Cockpit):
# ANTHROPIC_API_KEY=sk-ant-...        # Abrechnung über die API
# CLAUDE_CODE_OAUTH_TOKEN=...         # aus `claude setup-token` (Abo, 1 Jahr gültig)

# Entwicklung: Vite-Devserver als Origin zulassen
# DEV_ORIGINS=http://localhost:5173
