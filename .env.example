# Kopieren nach .env und anpassen. Alle Werte sind optional.

# Server (nur loopback; anderes erfordert ALLOW_NON_LOOPBACK=true – nicht empfohlen)
PORT=4317
# PREVIEW_PORT=4318          # Datei-Vorschau auf eigenem Origin (Standard: PORT+1)
HOST=127.0.0.1
OPEN_BROWSER=true

# Fernzugriff über Domain/Tunnel (Cloudflare Tunnel, Dev Tunnels, Tailscale – siehe README)
# Nicht nötig: Adressen werden beim ersten Passwort-Login dort automatisch freigegeben.
# Cloudflare Tunnel direkt aus dem Cockpit (auch: npx agentpit --tunnel oder Konto → Fernzugriff):
# TUNNEL=on                    # ohne Konto: zufällige https://….trycloudflare.com-Adresse
# CLOUDFLARE_TUNNEL_TOKEN=     # eigener Tunnel (feste Domain) aus Cloudflare Zero Trust → Networks → Tunnels
# Optional fest freigeben (mehrere mit Komma):
# PUBLIC_URL=https://cockpit.deine-domain.de
# Optional zweiter Origin für Datei-Vorschauen (sonst sandboxed über /p/… der Hauptadresse):
# PREVIEW_PUBLIC_URL=https://preview.deine-domain.de

# Ordner (relativ zum Cockpit-Ordner oder absolut)
PROJECTS_DIR=projects
DATA_DIR=data

# Sessions
DEFAULT_MODEL=                # leer = Standard von Claude Code; z. B. opus, sonnet, fable
DEFAULT_PERMISSION_MODE=acceptEdits   # default | acceptEdits | auto | plan | dontAsk
DEFAULT_EFFORT=               # leer | low | medium | high | xhigh | max
IDLE_TIMEOUT_MIN=20           # Prozess nach N min Leerlauf beenden (Session bleibt fortsetzbar), 0 = nie
MAX_RUNNERS=6                 # gleichzeitig laufende Claude-Code-Prozesse (je ca. 300–500 MB RAM; Jetson 8 GB: 3)
ALLOW_BYPASS_PERMISSIONS=false  # true schaltet den Modus "Alles erlauben" frei (auch in der UI: Konto → Freigaben)
PROMPT_SUGGESTIONS=false      # Vorschlag für den nächsten Prompt (kostet etwas Nutzung)
HISTORY_LIMIT=4000            # max. geladene Ereignisse pro Session-Ansicht

# Verbrauch
USAGE_POLL_SEC=300            # Plan-Limits abfragen, solange ein Browser verbunden ist

# Browser-Steuerung (Playwright MCP)
BROWSER_MCP=true
BROWSER_CHANNEL=              # leer = automatisch (chrome, sonst msedge)
MAX_BROWSERS=4                # gleichzeitig offene Browser-Identitäten (je ca. 300–600 MB RAM; Jetson 8 GB: 2)
# PLAYWRIGHT_BROWSERS_PATH=   # Standard: ./browsers (mitgelieferter Chromium, npm run install:browser)

# Kontext automatisch zusammenfassen ab dieser Füllung in % (0 = aus; pro Projekt änderbar)
AUTO_COMPACT_PCT=75

# Automatisches Aufräumen (Tage seit der letzten Änderung)
CLEANUP=true
BROWSER_ARTIFACT_DAYS=2       # output/browser: Seiten-Snapshots, Konsolen-Logs, Traces
BROWSER_MEDIA_DAYS=7          # output/browser: Aufnahmen und Screenshots von Playwright
WORK_DAYS=14                  # work/: Zwischenstände
OUTPUT_DAYS=0                 # output/: Ergebnisse – 0 = nie löschen
TRASH_DAYS=30                 # trash/: gelöschte Projekte und Identitäten
PROFILE_CACHE_MB=200          # Browser-Caches je Identität darüber → geleert (Logins bleiben)

# Eigene Claude-Code-Installation statt der aus dem Agent SDK (normalerweise nicht nötig)
# CLAUDE_BIN=C:\Users\<du>\.local\bin\claude.exe

# Authentifizierung ohne Login (hat Vorrang vor dem Login im Cockpit):
# ANTHROPIC_API_KEY=sk-ant-...        # Abrechnung über die API
# CLAUDE_CODE_OAUTH_TOKEN=...         # aus `claude setup-token` (Abo, 1 Jahr gültig)

# Entwicklung: Vite-Devserver als Origin zulassen
# DEV_ORIGINS=http://localhost:5173
